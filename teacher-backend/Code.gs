const VT={DB:'VICORA_TEACHER_DATABASE_ID',ADMIN:'VICORA_TEACHER_ADMIN_KEY',SHEETS:{TeacherUsers:['user_id','full_name','email','salt','password_hash','role','school_id','school_name','active','created_at'],TeacherSessions:['session_id','token_hash','user_id','role','school_id','expires_at','revoked'],TeacherSchools:['school_id','school_name','school_state','join_code','drive_folder_id','active','created_at'],TeacherDocuments:['document_id','user_id','school_id','doc_type','title','level','class_level','subject','term','week','topic','content_html','content_text','created_at','updated_at'],TeacherResources:['resource_id','school_id','file_id','file_name','mime_type','extracted_text','status','created_at'],TeacherAIUsage:['usage_id','user_id','school_id','task','provider','created_at']}};
const PROVIDERS=['gemini','groq','openrouter','mistral','cloudflare','nvidia','cohere','sambanova','openai','meta','claude','grok'];
const MODELS={gemini:'gemini-3.5-flash-lite',groq:'openai/gpt-oss-120b',openrouter:'meta-llama/llama-3.3-70b-instruct:free',mistral:'mistral-small-latest',cloudflare:'@cf/meta/llama-3.3-70b-instruct-fp8-fast',nvidia:'meta/llama-3.3-70b-instruct',cohere:'command-r7b-12-2024',sambanova:'Meta-Llama-3.3-70B-Instruct',openai:'gpt-4.1-mini',meta:'muse-spark-1.3',claude:'claude-sonnet-4-5',grok:'grok-4.7'};
function setupVICORATeacher(){const p=PropertiesService.getScriptProperties();let id=p.getProperty(VT.DB),ss=id?SpreadsheetApp.openById(id):SpreadsheetApp.create('VICORA TEACHER Database');if(!id)p.setProperty(VT.DB,ss.getId());Object.keys(VT.SHEETS).forEach(n=>{let sh=ss.getSheetByName(n);if(!sh)sh=ss.insertSheet(n);const h=VT.SHEETS[n];if(!sh.getLastRow()){sh.getRange(1,1,1,h.length).setValues([h]);sh.setFrozenRows(1);}});let folder=p.getProperty('VICORA_TEACHER_DRIVE_FOLDER_ID');if(!folder){folder=DriveApp.createFolder('VICORA TEACHER Storage').getId();p.setProperty('VICORA_TEACHER_DRIVE_FOLDER_ID',folder);}let key=p.getProperty(VT.ADMIN);if(!key){key=tokenVT_();p.setProperty(VT.ADMIN,key);}const result={ready:true,databaseUrl:ss.getUrl(),driveFolderUrl:DriveApp.getFolderById(folder).getUrl(),adminKey:key};Logger.log(JSON.stringify(result));return result;}
function doGet(){return jsonVT_({ok:true,service:'VICORA TEACHER API',version:'0.1.0'});}
function doPost(e){try{const b=JSON.parse(e.postData.contents||'{}');let d;switch(b.action){case'teacher.register':d=registerVT_(b);break;case'teacher.login':d=loginVT_(b);break;case'teacher.admin.login':d=adminLoginVT_(b);break;case'teacher.logout':d=logoutVT_(b);break;case'teacher.me':d=meVT_(b);break;case'teacher.documents.generate':d=generateVT_(b);break;case'teacher.documents.list':d=listDocsVT_(b);break;case'teacher.documents.get':d=getDocVT_(b);break;case'teacher.documents.save':d=saveDocVT_(b);break;case'teacher.resources.list':d=listResourcesVT_(b);break;case'teacher.resources.get':d=getResourceVT_(b);break;case'teacher.resources.upload':d=uploadResourceVT_(b);break;case'teacher.ai.chat':d=chatVT_(b);break;case'teacher.admin.schools':adminVT_(b);d={schools:readVT_('TeacherSchools')};break;case'teacher.admin.aiSettings':adminVT_(b);d=aiSettingsVT_();break;case'teacher.admin.saveAiSettings':adminVT_(b);d=saveAISettingsVT_(b);break;default:throw Error('Unsupported action.');}return jsonVT_({ok:true,data:d});}catch(x){return jsonVT_({ok:false,error:String(x.message||x)});}}
function registerVT_(b){const name=reqVT_(b.fullName,'Full name'),email=emailVT_(b.email),pw=String(b.password||''),schoolName=reqVT_(b.schoolName,'School name'),state=reqVT_(b.schoolState,'School state');if(pw.length<10)throw Error('Password must be at least 10 characters.');if(findVT_('TeacherUsers','email',email))throw Error('Email already registered.');let school,role,join=String(b.joinCode||'').toUpperCase();if(join){school=readVT_('TeacherSchools').find(s=>s.join_code===join&&s.active==='true');if(!school)throw Error('Invalid school join code.');role='teacher';}else{const sid=Utilities.getUuid(),root=DriveApp.getFolderById(PropertiesService.getScriptProperties().getProperty('VICORA_TEACHER_DRIVE_FOLDER_ID')),folder=root.createFolder(schoolName+'-'+sid.slice(0,8)),code=tokenVT_().slice(0,8).toUpperCase();school={school_id:sid,school_name:schoolName,school_state:state,join_code:code,drive_folder_id:folder.getId(),active:'true',created_at:new Date().toISOString()};appendVT_('TeacherSchools',school);role='school_admin';}const id=Utilities.getUuid(),salt=tokenVT_(),token=tokenVT_();appendVT_('TeacherUsers',{user_id:id,full_name:name,email:email,salt:salt,password_hash:hashVT_(salt+pw),role:role,school_id:school.school_id,school_name:school.school_name,active:'true',created_at:new Date().toISOString()});appendVT_('TeacherSessions',{session_id:Utilities.getUuid(),token_hash:hashVT_(token),user_id:id,role:role,school_id:school.school_id,expires_at:new Date(Date.now()+30*86400000).toISOString(),revoked:'false'});return{sessionToken:token,user:{userId:id,fullName:name,email:email,role:role,schoolId:school.school_id,schoolName:school.school_name,joinCode:role==='school_admin'?school.join_code:''}};}
function loginVT_(b){const email=emailVT_(b.email),u=findVT_('TeacherUsers','email',email),pw=String(b.password||'');if(!u||u.active!=='true'||u.password_hash!==hashVT_(u.salt+pw))throw Error('Email or password is incorrect.');const token=tokenVT_();appendVT_('TeacherSessions',{session_id:Utilities.getUuid(),token_hash:hashVT_(token),user_id:u.user_id,role:u.role,school_id:u.school_id,expires_at:new Date(Date.now()+30*86400000).toISOString(),revoked:'false'});return{sessionToken:token,user:{userId:u.user_id,fullName:u.full_name,email:u.email,role:u.role,schoolId:u.school_id,schoolName:u.school_name}};}
function adminLoginVT_(b){if(String(b.adminKey||'')!==PropertiesService.getScriptProperties().getProperty(VT.ADMIN))throw Error('Platform Admin key is incorrect.');const token=tokenVT_();appendVT_('TeacherSessions',{session_id:Utilities.getUuid(),token_hash:hashVT_(token),user_id:'PLATFORM_ADMIN',role:'platform_admin',school_id:'GLOBAL',expires_at:new Date(Date.now()+8*3600000).toISOString(),revoked:'false'});return{sessionToken:token,user:{userId:'PLATFORM_ADMIN',fullName:'VICORA Platform Admin',role:'platform_admin',schoolId:'GLOBAL',schoolName:'All schools'}};}
function authVT_(b){const t=String(b.sessionToken||''),s=findVT_('TeacherSessions','token_hash',hashVT_(t));if(!s||s.revoked==='true'||Date.parse(s.expires_at)<Date.now())throw Error('Please sign in again.');if(s.user_id==='PLATFORM_ADMIN')return{user_id:s.user_id,role:s.role,school_id:s.school_id};const u=findVT_('TeacherUsers','user_id',s.user_id);if(!u||u.active!=='true')throw Error('Account inactive.');return u;}
function adminVT_(b){const u=authVT_(b);if(u.role!=='platform_admin')throw Error('Platform Admin permission required.');return u;}
function logoutVT_(b){const s=findVT_('TeacherSessions','token_hash',hashVT_(b.sessionToken||''));if(s)updateVT_('TeacherSessions','session_id',s.session_id,{revoked:'true'});return{loggedOut:true};}
function meVT_(b){const u=authVT_(b);return{user:{userId:u.user_id,fullName:u.full_name||'VICORA Platform Admin',email:u.email||'',role:u.role,schoolId:u.school_id,schoolName:u.school_name||'All schools'}};}
function generateVT_(b){const u=authVT_(b),type=String(b.docType||'lesson_note'),level=String(b.level||'').toUpperCase(),cls=reqVT_(b.classLevel,'Class'),subject=reqVT_(b.subject,'Subject'),topic=reqVT_(b.topic,'Topic');if(['PRIMARY','JUNIOR_SECONDARY','SENIOR_SECONDARY'].indexOf(level)<0)throw Error('Select a Nigerian school level.');const refs=refsVT_(u,topic+' '+subject+' '+cls),prompt='You are VICORA TEACHER, an expert Nigerian teacher. Create a professional '+type+' for '+level+' '+cls+'. Subject: '+subject+'. Term: '+(b.term||'First Term')+'. Week: '+(b.week||'')+'. Topic: '+topic+'. Teacher instructions: '+(b.instructions||'')+'. Use Nigerian/British English and school-appropriate detail. For Primary lesson notes use learning objectives, materials, previous knowledge, introduction, teacher/pupil activities, evaluation, conclusion and assignment. For JSS/SSS use behavioural objectives, entry behaviour, resources, references, stepwise presentation, teacher/learner activities, board summary, evaluation, assignment and reflection. For schemes use a week-by-week table. For exams include clear objective/theory sections, marks and answer key. Use clean semantic HTML, no emoji or decorative symbols. Return only JSON with title, contentHtml and contentText. Reference extracts: '+(refs.map(r=>r.name+': '+r.text).join('\n\n')||'No uploaded reference matched. Do not claim to have consulted official curriculum.');const ai=callAIVT_(prompt);let out;try{out=JSON.parse(ai.answer);}catch(e){out={title:topic,contentHtml:'<h1>'+escVT_(topic)+'</h1><p>'+escVT_(ai.answer).replace(/\n/g,'<br>')+'</p>',contentText:ai.answer};}const id=Utilities.getUuid(),now=new Date().toISOString();appendVT_('TeacherDocuments',{document_id:id,user_id:u.user_id,school_id:u.school_id,doc_type:type,title:String(out.title||topic),level:level,class_level:cls,subject:subject,term:String(b.term||'First Term'),week:String(b.week||''),topic:topic,content_html:String(out.contentHtml||'').slice(0,45000),content_text:String(out.contentText||'').slice(0,45000),created_at:now,updated_at:now});appendVT_('TeacherAIUsage',{usage_id:Utilities.getUuid(),user_id:u.user_id,school_id:u.school_id,task:type,provider:ai.provider,created_at:now});return{documentId:id,title:out.title||topic,contentHtml:out.contentHtml||'',contentText:out.contentText||'',provider:ai.provider};}
function listDocsVT_(b){const u=authVT_(b);let a=readVT_('TeacherDocuments').filter(d=>d.school_id===u.school_id);if(u.role==='teacher')a=a.filter(d=>d.user_id===u.user_id);return{documents:a.reverse().slice(0,60).map(d=>({documentId:d.document_id,title:d.title,docType:d.doc_type,subject:d.subject,classLevel:d.class_level,updatedAt:d.updated_at}))};}
function getDocVT_(b){const u=authVT_(b),d=findVT_('TeacherDocuments','document_id',b.documentId);if(!d||d.school_id!==u.school_id||(u.role==='teacher'&&d.user_id!==u.user_id))throw Error('Document not found.');return{documentId:d.document_id,title:d.title,docType:d.doc_type,contentHtml:d.content_html,contentText:d.content_text};}
function saveDocVT_(b){const u=authVT_(b),d=findVT_('TeacherDocuments','document_id',b.documentId);if(!d||d.school_id!==u.school_id||(u.role==='teacher'&&d.user_id!==u.user_id))throw Error('Document not found or access denied.');const html=String(b.contentHtml||'').slice(0,45000);if(!html)throw Error('Document content is empty.');const plain=String(b.contentText||html.replace(/<[^>]*>/g,' ')).slice(0,45000);updateVT_('TeacherDocuments','document_id',d.document_id,{content_html:html,content_text:plain,version:String((Number(d.version)||1)+1),updated_at:new Date().toISOString()});return{saved:true,documentId:d.document_id,version:(Number(d.version)||1)+1};}
function uploadResourceVT_(b){const u=authVT_(b);if(['platform_admin','school_admin'].indexOf(u.role)<0)throw Error('Administrator permission required.');const name=reqVT_(b.fileName,'File name'),mime=String(b.mimeType||''),base=String(b.fileBase64||'');if(base.length>9000000)throw Error('Upload limit is 6 MB.');const bytes=Utilities.base64Decode(base);if(bytes.length>6*1024*1024)throw Error('Upload limit is 6 MB.');const sid=u.role==='platform_admin'?String(b.targetSchoolId||'GLOBAL'):u.school_id;if(u.role==='school_admin'&&sid!==u.school_id)throw Error('You can only upload to your school.');let folder;if(sid==='GLOBAL'){const root=DriveApp.getFolderById(PropertiesService.getScriptProperties().getProperty('VICORA_TEACHER_DRIVE_FOLDER_ID')),it=root.getFoldersByName('Global Curriculum Library');folder=it.hasNext()?it.next():root.createFolder('Global Curriculum Library');}else{const s=findVT_('TeacherSchools','school_id',sid);if(!s)throw Error('School not found.');folder=DriveApp.getFolderById(s.drive_folder_id);}const file=folder.createFile(Utilities.newBlob(bytes,mime,name)),id=Utilities.getUuid();appendVT_('TeacherResources',{resource_id:id,school_id:sid,file_id:file.getId(),file_name:name,mime_type:mime,extracted_text:String(b.extractedText||'').slice(0,45000),status:'active',created_at:new Date().toISOString()});return{resourceId:id,fileName:name};}
function listResourcesVT_(b){const u=authVT_(b);return{resources:readVT_('TeacherResources').filter(r=>r.status==='active'&&(r.school_id==='GLOBAL'||r.school_id===u.school_id)).map(r=>({resourceId:r.resource_id,fileName:r.file_name,createdAt:r.created_at,hasExtractedText:!!r.extracted_text}))};}
function getResourceVT_(b){const u=authVT_(b),r=findVT_('TeacherResources','resource_id',b.resourceId);if(!r||!(r.school_id==='GLOBAL'||r.school_id===u.school_id))throw Error('Resource not found.');return{resourceId:r.resource_id,fileName:r.file_name,extractedText:r.extracted_text};}
function refsVT_(u,q){const terms=String(q).toLowerCase().split(' ').filter(x=>x.length>2);return readVT_('TeacherResources').filter(r=>r.status==='active'&&r.extracted_text&&(r.school_id==='GLOBAL'||r.school_id===u.school_id)).map(r=>({name:r.file_name,text:r.extracted_text,score:terms.filter(w=>(r.file_name+' '+r.extracted_text).toLowerCase().indexOf(w)>=0).length})).filter(r=>r.score>0).sort((a,b)=>b.score-a.score).slice(0,3).map(r=>({name:r.name,text:r.text.slice(0,3500)}));}
function chatVT_(b){const u=authVT_(b),q=String(b.question||'').slice(0,3000);if(!q)throw Error('Enter a question.');const refs=refsVT_(u,q),ai=callAIVT_('You are VICORA TEACHER AI, an expert Nigerian Primary, JSS and SSS teacher. Answer accurately, prefer supplied references, distinguish facts from suggestions, never invent official curriculum citations, use Nigerian/British English, clear headings and no emojis. References: '+refs.map(r=>r.name+': '+r.text).join('\n\n')+'\nTeacher question: '+q);return{answer:ai.answer,provider:ai.provider,references:refs.map(r=>r.name)};}
function aiSettingsVT_(){const p=PropertiesService.getScriptProperties(),providers={};PROVIDERS.forEach(k=>providers[k]={configured:!!p.getProperty('VICORA_'+k.toUpperCase()+'_API_KEY'),model:p.getProperty('VICORA_'+k.toUpperCase()+'_MODEL')||MODELS[k]});return{providers:providers,providerOrder:p.getProperty('VICORA_AI_PROVIDER_ORDER')||PROVIDERS.join(',')};}
function saveAISettingsVT_(b){const p=PropertiesService.getScriptProperties();PROVIDERS.forEach(k=>{if(b[k+'Key'])p.setProperty('VICORA_'+k.toUpperCase()+'_API_KEY',String(b[k+'Key']).trim());if(b[k+'Model'])p.setProperty('VICORA_'+k.toUpperCase()+'_MODEL',String(b[k+'Model']).trim());});if(b.providerOrder)p.setProperty('VICORA_AI_PROVIDER_ORDER',String(b.providerOrder));return aiSettingsVT_();}
function callAIVT_(prompt){const p=PropertiesService.getScriptProperties(),order=(p.getProperty('VICORA_AI_PROVIDER_ORDER')||PROVIDERS.join(',')).split(',').map(x=>x.trim()).filter(x=>PROVIDERS.indexOf(x)>=0);let last='No AI provider configured.',used=[];for(const k of order){const key=p.getProperty('VICORA_'+k.toUpperCase()+'_API_KEY');if(!key)continue;used.push(k);try{const model=p.getProperty('VICORA_'+k.toUpperCase()+'_MODEL')||MODELS[k];let url,headers={Authorization:'Bearer '+key},payload;if(k==='gemini'){url='https://generativelanguage.googleapis.com/v1beta/models/'+encodeURIComponent(model)+':generateContent?key='+encodeURIComponent(key);headers={};payload={contents:[{parts:[{text:prompt}]}],generationConfig:{temperature:0.2,maxOutputTokens:6000}};}else if(k==='claude'){url='https://api.anthropic.com/v1/messages';headers={'x-api-key':key,'anthropic-version':'2023-06-01'};payload={model:model,max_tokens:6000,messages:[{role:'user',content:prompt}]};}else if(k==='cohere'){url='https://api.cohere.com/v2/chat';payload={model:model,messages:[{role:'user',content:prompt}],max_tokens:6000};}else{const base=k==='groq'?'https://api.groq.com/openai/v1':k==='openai'?'https://api.openai.com/v1':k==='meta'?'https://api.meta.ai/v1':k==='grok'?'https://api.x.ai/v1':k==='mistral'?'https://api.mistral.ai/v1':k==='openrouter'?'https://openrouter.ai/api/v1':k==='nvidia'?'https://integrate.api.nvidia.com/v1':k==='sambanova'?'https://api.sambanova.ai/v1':'';if(k==='cloudflare'&&!p.getProperty('VICORA_CLOUDFLARE_ACCOUNT_ID'))throw Error('Cloudflare Account ID missing.');url=k==='cloudflare'?'https://api.cloudflare.com/client/v4/accounts/'+p.getProperty('VICORA_CLOUDFLARE_ACCOUNT_ID')+'/ai/v1/chat/completions':base+'/chat/completions';payload={model:model,messages:[{role:'user',content:prompt}],temperature:0.2,max_tokens:6000};}const res=UrlFetchApp.fetch(url,{method:'post',contentType:'application/json',headers:headers,payload:JSON.stringify(payload),muteHttpExceptions:true}),data=JSON.parse(res.getContentText());if(res.getResponseCode()>=300)throw Error('HTTP '+res.getResponseCode()+': '+String(data.error&&data.error.message||'request failed'));const answer=k==='gemini'?((data.candidates||[])[0].content.parts||[]).map(x=>x.text||'').join(''):k==='claude'?(data.content||[]).map(x=>x.text||'').join(''):k==='cohere'?(data.message.content||[]).map(x=>x.text||'').join(''):data.choices[0].message.content;if(!answer)throw Error('Empty response.');return{provider:k,answer:String(answer)};}catch(e){last=k+': '+String(e.message||e);}}if(!used.length)throw Error('No AI provider key configured in Teacher Apps Script settings.');throw Error('All AI providers failed. '+last+' Tried: '+used.join(' → '));}
function dbVT_(){const id=PropertiesService.getScriptProperties().getProperty(VT.DB);if(!id)throw Error('Run setupVICORATeacher first.');return SpreadsheetApp.openById(id);}
function readVT_(n){const sh=dbVT_().getSheetByName(n),v=sh.getDataRange().getValues();if(v.length<2)return[];const h=v[0].map(String);return v.slice(1).filter(r=>r.some(x=>x!=='')).map(r=>{const o={};h.forEach((k,i)=>o[k]=String(r[i]==null?'':r[i]));return o;});}
function appendVT_(n,o){const sh=dbVT_().getSheetByName(n),h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(String);sh.appendRow(h.map(k=>Object.prototype.hasOwnProperty.call(o,k)?o[k]:''));}
function findVT_(n,k,v){const t=String(v).toLowerCase();return readVT_(n).find(r=>String(r[k]||'').toLowerCase()===t)||null;}
function updateVT_(n,k,v,u){const sh=dbVT_().getSheetByName(n),h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(String),c=h.indexOf(k),rows=Math.max(0,sh.getLastRow()-1),f=rows?sh.getRange(2,c+1,rows,1).createTextFinder(String(v)).matchEntireCell(true).findNext():null;if(!f)throw Error('Record not found.');const rg=sh.getRange(f.getRow(),1,1,h.length),r=rg.getValues()[0];h.forEach((x,i)=>{if(Object.prototype.hasOwnProperty.call(u,x))r[i]=u[x];});rg.setValues([r]);}
function reqVT_(v,label){const s=String(v||'').trim().slice(0,240);if(!s)throw Error(label+' is required.');return s;}
function emailVT_(v){const e=reqVT_(v,'Email').toLowerCase();if(e.indexOf('@')<1||e.indexOf('.')<0)throw Error('Enter a valid email.');return e;}
function tokenVT_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');}
function hashVT_(v){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(v),Utilities.Charset.UTF_8).map(b=>('0'+(b<0?b+256:b).toString(16)).slice(-2)).join('');}
function safeVT_(e){return String(e&&e.message?e.message:e||'Unknown error').slice(0,450);}
function jsonVT_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
function escVT_(s){return String(s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));}
